{
  "name": "hubspot-desktop",
  "version": "1.0.0",
  "description": "Native Mac desktop app for HubSpot",
  "main": "src/main/main.js",
  "author": "HubSpot Desktop User",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "fixture": "node test/fixture/server.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.hubspot.desktop",
    "productName": "HubSpot Desktop",
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
